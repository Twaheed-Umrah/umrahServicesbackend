# ==============================================================================
# Masar Umrah CRM - AWS EC2 Instance Production Configuration
# Domain: umrahdesk.masarumrah.com
# Database: SQLite (db.sqlite3 inside this EC2 instance)
# Storage: Local filesystem (/media/) with full HTTPS absolute URLs
# ==============================================================================

# Core Django Security
SECRET_KEY=masar-umrah-tawheed-786-ec2-production-key
DEBUG=False
ALLOWED_HOSTS=umrahdesk.masarumrah.com,*.masarumrah.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://umrahdesk.masarumrah.com,http://umrahdesk.masarumrah.com

# Server Base URL (Constructs full absolute URLs for documents, passports, and photos)
BACKEND_URL=https://umrahdesk.masarumrah.com

# Database: SQLite on this EC2 instance (stored at umrahServicesbackend/db.sqlite3)
# Leave DATABASE_URL blank or commented out!
# DATABASE_URL=

# Media Storage: Stored on this EC2 instance under /media/ (No external AWS S3 required)
USE_S3=False

# SMTP Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=masarumrahservice072@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password_here
DEFAULT_FROM_EMAIL=Masar Umrah Services <masarumrahservice072@gmail.com>
